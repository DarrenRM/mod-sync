# Names only. Nothing here is a real value, and the tools do not load this file by themselves:
# export the variables in your shell, or run a tool as `node --env-file=.env tools/<tool>.mjs`.

# URL of the deployed Cloudflare Worker, no trailing slash. Baked into app builds
# (tools/release-app.mjs), used by tools/reports.mjs and `tools/e2e/sandbox.mjs --live`, and read by
# the app at runtime to override the baked-in value (point it at `wrangler dev` for local work).
MODSYNC_BASE_URL=

# Password for the updater signing key in .keys/updater.key. Leave empty if the key has none.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Test sandbox: keep the app off the real Steam library and app data.
MODSYNC_STEAM_PATH=
MODSYNC_DATA_DIR=

# Files that stay out of the repo (gitignored):
#   .keys/updater.key        Tauri updater signing key
#   .keys/admin-token        the Worker's ADMIN_TOKEN secret (set it with `wrangler secret put ADMIN_TOKEN`)
#   worker/wrangler.local.jsonc   wrangler.jsonc with the real KV namespace id
