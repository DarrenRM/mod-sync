# Dependencies and build output
node_modules/
dist/
build/
target/
src-tauri/target/
crates/*/target/
src-tauri/gen/schemas/
worker/node_modules/
worker/.wrangler/
*.log

# Secrets and local configuration (see .env.example)
.env
.env.*
!.env.example
.keys/
*.key
*.pem
worker/.dev.vars
worker/wrangler.local.jsonc

# Bug reports downloaded from the Worker (contain players' logs)
reports/

# Everything the Worker serves is generated by the publish/release tools and deployed from a
# local checkout: installers, mod packages, catalog and updater manifests, Steam artwork.
worker/public/app/
worker/public/packages/
worker/public/games/
worker/public/catalog.json

# Installers and bundles
*.exe
*.msi
*.nsis
*.sig

# Editor and OS
.DS_Store
Thumbs.db

# Claude Code local session files
.claude/scheduled_tasks.lock
.claude/settings.local.json
