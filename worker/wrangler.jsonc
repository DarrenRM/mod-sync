{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mod-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/reports", "/admin/*", "/catalog.json", "/app/latest.json"]
  },
  "kv_namespaces": [{ "binding": "REPORTS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }]
}
